# Copy to .env.local and fill in.

# Site
SITE_URL=http://localhost:3000
ENROLMENT_STATUS=open            # open | closed — controls every enroll button

# Stripe Checkout (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...        # one-time USD price for cohort tuition
STRIPE_WEBHOOK_SECRET=whsec_...  # endpoint: $SITE_URL/api/stripe/webhook

# Email notifications (https://resend.com) — logged to the console when unset
RESEND_API_KEY=
MAIL_FROM="Regal Cyber Academy <no-reply@yourdomain.com>"

# Admin export API (Authorization: Bearer $ADMIN_TOKEN)
ADMIN_TOKEN=
# Signs waitlist unsubscribe links — required in production
UNSUBSCRIBE_SECRET=
